{
  "enabledPlugins": {
    "security-guidance@anthropic-plugin-directory": true
  },
  "permissions": {
    "allow": [
      "mcp__codegraph__*"
    ],
    "deny": [
      "Read(prompts.md)",
      "Edit(prompts.md)",
      "Read(README.md)",
      "Edit(README.md)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph prompt-hook"
          }
        ]
      }
    ]
  }
}