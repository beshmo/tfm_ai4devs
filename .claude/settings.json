{
  "enabledPlugins": {
    "security-guidance@anthropic-plugin-directory": true
  },
  "permissions": {
    "allow": [
      "mcp__codegraph__*"
    ],
    "deny": [
      "Read(prompts.md)",
      "Edit(prompts.md)",
      "Edit(docs/propuesta/dominio.md)",
      "Edit(docs/propuesta/interfaz.md)",
      "Edit(docs/propuesta/informe.md)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph prompt-hook"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-main-commit.js\""
          }
        ]
      }
    ]
  }
}